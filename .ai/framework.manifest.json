{
  "version": "3.0.0",
  "name": "MyBestBooking AI Development Operating System (AI-DOS)",
  "description": "Gouvernance et traçabilité des preuves techniques pour Next.js et PostgreSQL",
  "mandatory_documents": [
    "STATE.md",
    "INDEX.md",
    "TRACEABILITY.md",
    "MISSION.md",
    "PROJECT.md",
    "ARCHITECTURE_MYBESTBOOKING.md",
    "DATABASE.md",
    "SECURITY.md",
    "CODING_RULES.md",
    "ANDROID_RULES.md",
    "ROADMAP.md",
    "BUGS.md",
    "CURRENT_TASK.md",
    "TEST_PLAN.md",
    "DEVLOG.md"
  ],
  "optional_documents": [
    "DEPENDENCIES.md",
    "KNOWN_LIMITATIONS.md",
    "PROCESS_IMPROVEMENTS.md",
    "DEV_ENVIRONMENT.md"
  ],
  "reading_order": [
    "STATE.md",
    "INDEX.md",
    "framework.manifest.json",
    "MISSION.md",
    "CURRENT_TASK.md",
    "PROJECT.md",
    "ARCHITECTURE_MYBESTBOOKING.md"
  ],
  "critical_documents": [
    "STATE.md",
    "SECURITY.md",
    "DATABASE.md",
    "CODING_RULES.md",
    "ADR/"
  ],
  "roles": [
    "Architecte",
    "Développeur Next.js senior",
    "Expert TypeScript",
    "Expert React (RSC / Client)",
    "Expert Drizzle / SQL",
    "Expert PostgreSQL",
    "Expert sécurité web (auth, cookies, CSP)",
    "Ingénieur QA",
    "DevOps / SRE",
    "Expert UX / a11y",
    "Relecteur (advocatus diaboli)"
  ],
  "proportionality_levels": {
    "T": "Trivial",
    "L": "Local",
    "S": "Structurant",
    "C": "Critique"
  },
  "blocking_rules": {
    "missing_mandatory_document": true,
    "obsolete_roadmap": true,
    "unresolved_critical_bugs": false,
    "mismatched_git_state": true
  }
}
