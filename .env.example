# MyBestBooking — variables d'environnement
#
# Copier ce fichier en `.env.local` et ajuster les valeurs.
# NE JAMAIS commiter `.env.local` (ignoré par .gitignore).

# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL — OBLIGATOIRE
# ─────────────────────────────────────────────────────────────
# En dev, `npm run db:dev` démarre un Postgres embarqué sur le port 55432.
# En prod, pointer vers votre instance managée (Neon, Supabase, RDS…).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/app_db"

# ─────────────────────────────────────────────────────────────
# Secret JWT — OBLIGATOIRE (le serveur refuse de démarrer si absent)
# ─────────────────────────────────────────────────────────────
# Générer un secret aléatoire fort (≥ 32 caractères recommandés) :
#   openssl rand -hex 32
# Sur < 32 caractères, un warning est émis mais le serveur démarre.
# Voir ADR-003 et .ai/SECURITY.md.
JWT_SECRET="remplacer-par-openssl-rand-hex-32"

# Clé maître du coffre web des providers (T-103) — OBLIGATOIRE si vous
# souhaitez saisir Stripe/Resend/S3 dans /dashboard/settings. 32 octets,
# encodés en hex (64 caractères) ou Base64. Ne jamais la commiter ni la saisir
# dans l'interface web.
# CREDENTIALS_ENCRYPTION_KEY=""
# Rotation contrôlée : définir temporairement la nouvelle clé ci-dessus et
# l’ancienne ici, appeler POST /api/admin/providers/rotation depuis le panneau
# admin, vérifier, puis retirer cette variable. Ne jamais exposer ces valeurs.
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""

# ─────────────────────────────────────────────────────────────
# Seed en production — OPTIONNEL
# ─────────────────────────────────────────────────────────────
# En dev/test, POST /api/seed est autorisé par défaut sauf flag démo off.
# En prod, la route retourne 404 sauf si DEMO_SEED_ENABLED=true et si
# SEED_TOKEN est défini côté serveur ET fourni dans l'en-tête `x-seed-token`
# par la requête. Voir ADR-004 et BUG-002.
# Générer avec : openssl rand -hex 32
# Laisser vide pour désactiver le seed en prod (recommandé).
# SEED_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Démonstration publique — OPTIONNEL, désactivé par défaut en production
# ─────────────────────────────────────────────────────────────
# Ces flags affichent les comptes démo et/ou le bouton de seed dans l'UI.
# Pour autoriser réellement la connexion aux comptes de seed en production de
# démonstration, poser aussi DEMO_LOGIN_ENABLED="true" côté serveur.
# Ne pas activer sur une production ouverte aux vrais utilisateurs.
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
# DEMO_LOGIN_ENABLED="false"
# NEXT_PUBLIC_ENABLE_DEMO_SEED="false"
# DEMO_SEED_ENABLED="false"

# ─────────────────────────────────────────────────────────────
# Réservations sans paiement plateforme — OPTIONNEL
# ─────────────────────────────────────────────────────────────
# TTL métier des demandes pending sans paiement (heures), défaut 24, max 168.
# Le cron /api/cron/price-alerts annule/libère les demandes expirées.
# BOOKING_REQUEST_TTL_HOURS="24"

# ─────────────────────────────────────────────────────────────
# Tâches planifiées — obligatoire en production pour /api/cron/*
# ─────────────────────────────────────────────────────────────
# Vercel transmet automatiquement Authorization: Bearer <CRON_SECRET>
# à la planification déclarée dans vercel.json. Générer une valeur longue :
# openssl rand -hex 32
# CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# URL publique de l'application — recommandé
# ─────────────────────────────────────────────────────────────
# Utilisée pour la redirection après logout et les liens absolus.
# En prod : https://votre-domaine.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Emails transactionnels (T-013) — OPTIONNEL en dev
# ─────────────────────────────────────────────────────────────
# Sans RESEND_API_KEY, les emails sont écrits dans .data/mails/*.txt
# (utile pour dev / tests). Avec la clé, ils partent via Resend.
# https://resend.com/api-keys
# RESEND_API_KEY=""
# MAIL_FROM="MyBestBooking <no-reply@votre-domaine.com>"

# SMTP Gmail — utilisé en priorité si SMTP_USER et SMTP_PASSWORD sont définis.
# Pour Gmail, utiliser un mot de passe d'application (2FA requis), jamais le
# mot de passe principal du compte.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="votre-adresse@gmail.com"
# SMTP_PASSWORD=""
# SMTP_FROM="MyBestBooking <votre-adresse@gmail.com>"

# ─────────────────────────────────────────────────────────────
# Stockage d'images (T-014) — OPTIONNEL en dev
# ─────────────────────────────────────────────────────────────
# Sans ces variables, les uploads vont dans public/uploads/ (dev).
# En prod, définir toutes les variables pour utiliser S3/R2/etc.
# S3_ENDPOINT="s3.eu-west-3.amazonaws.com"
# S3_REGION="eu-west-3"
# S3_BUCKET="mybestbooking-uploads"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_BASE_URL="https://cdn.mybestbooking.com"

# ─────────────────────────────────────────────────────────────
# Stripe legacy (T-020) — INACTIF dans le tunnel depuis T-207
# ─────────────────────────────────────────────────────────────
# Les réservations voyageurs ne déclenchent plus de paiement plateforme.
# Ces variables ne servent qu'à des reprises legacy contrôlées hors parcours public.
# Créer les clés : https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─────────────────────────────────────────────────────────────
# Versements plateforme legacy — OPTIONNEL, désactivé par défaut
# ─────────────────────────────────────────────────────────────
# Depuis T-207, la plateforme ne collecte plus les paiements voyageurs : les
# routes mutables de payout (POST host, compte de versement, cron) restent
# fermées sauf opt-in serveur explicite pour un environnement legacy contrôlé.
# PLATFORM_PAYOUTS_ENABLED="false"
